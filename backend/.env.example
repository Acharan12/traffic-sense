PORT=5000
MONGODB_URI=mongodb://localhost:27017/trafficsense
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# News API (get free key at gnews.io or newsapi.org)
NEWS_API_KEY=your_news_api_key
NEWS_API_PROVIDER=gnews
# gnews or newsapi

# Weather API (get free key at openweathermap.org)
WEATHER_API_KEY=your_openweathermap_api_key

# Routing (get free key at openrouteservice.org)
ROUTING_API_KEY=your_openrouteservice_api_key
ROUTING_API_URL=https://api.openrouteservice.org/v2/directions

# ML Service URL
ML_SERVICE_URL=http://localhost:8000

# Demo mode - works without any external API keys
DEMO_MODE=true

# Cache durations (milliseconds)
NEWS_CACHE_TTL=600000
WEATHER_CACHE_TTL=600000

# CORS
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
